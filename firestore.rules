rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Bins collection - Read all, only admins can write
    match /bins/{binId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // System settings - Read all, only admins can write
    match /system-settings/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Users collection - Users can read their own data, admins can read/write all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    
    // Alerts collection - Read all authenticated users, system can write
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Allow system to create alerts
      allow update, delete: if isAdmin();
    }
    
    // WhatsApp logs - Admin read, system write
    match /whatsapp-logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Allow system to log messages
    }
    
    // WhatsApp status events - Admin read, system write
    match /whatsapp-status-events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Allow webhook to write
    }
    
    // WhatsApp errors - Admin read, system write
    match /whatsapp-errors/{errorId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Allow system to log errors
    }
    
    // WhatsApp incoming messages - Admin read, system write
    match /whatsapp-incoming-messages/{messageId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Allow webhook to write
      allow update: if isAdmin(); // Allow admin to mark as processed
    }
    
    // Alert locks - Used to prevent duplicate WhatsApp notifications
    // Automatically managed by the system via transactions
    match /alert-locks/{lockId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated(); // Allow system to manage locks
    }
  }
}

